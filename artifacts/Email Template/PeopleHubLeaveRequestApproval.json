	"translation": null,
	"name": "PeopleHubLeaveRequestApproval",
	"description": "Leave request from {=requesterName}: {=periodText}",
	"content": [
		"==OBJECT STRING==",
		"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f4f1f3;margin:0;padding:0;\">",
		"  <tr>",
		"    <td align=\"center\" style=\"padding:32px 12px;\">",
		"      <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e6dfe4;font-family:Arial,Helvetica,sans-serif;\">",
		"        <tr>",
		"          <td style=\"background-color:#38112A;padding:22px 32px;font-size:17px;font-weight:bold;color:#ffffff;\">PeopleHub Leave Requests</td>",
		"        </tr>",
		"        <tr><td style=\"background-color:#FF9E33;height:4px;line-height:4px;font-size:0;\">&nbsp;</td></tr>",
		"        <tr>",
		"          <td style=\"padding:32px 32px 8px 32px;\">",
		"            <div style=\"font-size:12px;font-weight:bold;color:#6E5774;letter-spacing:1px;\">APPROVAL REQUIRED</div>",
		"            <div style=\"font-size:24px;font-weight:bold;color:#38112A;padding-top:6px;\">{=typeText}: {=workingDays} working day(s)</div>",
		"            <div style=\"font-size:15px;color:#6E5774;padding-top:4px;\">{=periodText}</div>",
		"          </td>",
		"        </tr>",
		"        <tr>",
		"          <td style=\"padding:16px 32px 8px 32px;font-size:15px;line-height:23px;color:#38112A;\">",
		"            Hello,<br><br>",
		"            <strong>{=requesterName}</strong> sent this leave request for your approval. The working days were counted with the public holidays from SAP, and SAP confirmed the leave quota.",
		"          </td>",
		"        </tr>",
		"        <tr>",
		"          <td style=\"padding:16px 32px;\">",
		"            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border:1px solid #e6dfe4;border-radius:8px;\">",
		"              <tr>",
		"                <td style=\"padding:12px 16px;font-size:13px;color:#6E5774;border-bottom:1px solid #f1ecef;width:40%;\">Employee (SAP)</td>",
		"                <td style=\"padding:12px 16px;font-size:15px;color:#38112A;border-bottom:1px solid #f1ecef;\">{=employeeName} ({=pernr})</td>",
		"              </tr>",
		"              <tr>",
		"                <td style=\"padding:12px 16px;font-size:13px;color:#6E5774;border-bottom:1px solid #f1ecef;\">Absence type</td>",
		"                <td style=\"padding:12px 16px;font-size:15px;color:#38112A;border-bottom:1px solid #f1ecef;\">{=typeText}</td>",
		"              </tr>",
		"              <tr>",
		"                <td style=\"padding:12px 16px;font-size:13px;color:#6E5774;border-bottom:1px solid #f1ecef;\">Period</td>",
		"                <td style=\"padding:12px 16px;font-size:15px;color:#38112A;border-bottom:1px solid #f1ecef;\">{=periodText}</td>",
		"              </tr>",
		"              <tr>",
		"                <td style=\"padding:12px 16px;font-size:13px;color:#6E5774;border-bottom:1px solid #f1ecef;\">Working days</td>",
		"                <td style=\"padding:12px 16px;font-size:15px;font-weight:bold;color:#38112A;border-bottom:1px solid #f1ecef;\">{=workingDays}</td>",
		"              </tr>",
		"              <tr>",
		"                <td style=\"padding:12px 16px;font-size:13px;color:#6E5774;\">Comment</td>",
		"                <td style=\"padding:12px 16px;font-size:15px;color:#38112A;\">{=comment}</td>",
		"              </tr>",
		"            </table>",
		"          </td>",
		"        </tr>",
		"        <tr>",
		"          <td style=\"padding:8px 32px 28px 32px;font-size:15px;line-height:23px;color:#38112A;\">",
		"            Open <strong>Approve Leave Request</strong> in the launchpad to approve or reject it.",
		"          </td>",
		"        </tr>",
		"        <tr>",
		"          <td style=\"background-color:#f7f4f6;border-top:1px solid #e6dfe4;padding:18px 32px;font-size:12px;line-height:18px;color:#6E5774;\">",
		"            You receive this email because you have the leave manager role. Sent automatically; please don't reply.",
		"          </td>",
		"        </tr>",
		"      </table>",
		"    </td>",
		"  </tr>",
		"</table>",
		""
	],

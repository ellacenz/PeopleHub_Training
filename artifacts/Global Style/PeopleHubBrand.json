	"calculated": [
		"==OBJECT STRING==",
		"/* ============================================================",
		"   PeopleHub brand – Global CSS Style for the launchpad (exercise 4.0)",
		"   Fictional customer \"PeopleHub\". Works on top of the theme",
		"   sap_horizon_dark: only colours, fonts, the logo and shapes change.",
		"   ============================================================ */",
		"@import url(\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap\");",
		"",
		"/* 1. Brand colours and font. The --sap... variables brand the apps too (buttons, links, focus). */",
		":root {",
		"    --ph-teal: #14B8A6;",
		"    --ph-teal-light: #5EEAD4;",
		"    --ph-coral: #FF7A59;",
		"    --ph-navy: #0B1726;",
		"    --ph-surface: #13233A;",
		"    --ph-surface-hover: #183050;",
		"    --ph-line: rgba(94, 234, 212, 0.18);",
		"    --ph-text: #E8F1F8;",
		"    --ph-text-muted: #9FB3C8;",
		"    --ph-font: \"Plus Jakarta Sans\", \"72\", Arial, sans-serif;",
		"",
		"    --sapBrandColor: var(--ph-teal);",
		"    --sapHighlightColor: var(--ph-teal);",
		"    --sapLinkColor: var(--ph-teal-light);",
		"    --sapButton_Emphasized_Background: var(--ph-teal);",
		"    --sapButton_Emphasized_BorderColor: var(--ph-teal);",
		"    --sapButton_Emphasized_Hover_Background: #0D9488;",
		"    --sapButton_Emphasized_TextColor: #04231F;",
		"    --sapContent_FocusColor: var(--ph-coral);",
		"    --sapSelectedColor: var(--ph-teal);",
		"}",
		"",
		"/* 2. Font for the whole launchpad */",
		"#appShell, #appShell .sapMTitle, #appShell .sapMText, #appShell .sapMLabel, #appShell .sapFCardTitle, #appShell .sapFCardSubtitle {",
		"    font-family: var(--ph-font);",
		"}",
		"",
		"/* 3. Header: navy, a teal line underneath, and the PeopleHub logo instead of the Neptune logo */",
		"#nepLaunchpadTopOuter {",
		"    border-bottom: 3px solid var(--ph-teal);",
		"}",
		"#nepLaunchpadTopInner {",
		"    background: linear-gradient(90deg, var(--ph-navy) 0%, #102A43 55%, #0F3D45 100%) !important;",
		"}",
		"#inDummySearch-F.sapMSFF {",
		"    background: rgba(255, 255, 255, 0.06);",
		"    border-color: var(--ph-line);",
		"}",
		"#AppCacheShellLogoDesktop, #AppCacheShellLogoMobile {",
		"    content: url(\"data:image/svg+xml;base64,\");",
		"    height: 30px !important;",
		"    width: auto !important;",
		"}",
		"",
		"/* 4. Page background: deep navy with two soft brand glows */",
		"#launchpadContainer, #launchpadContainerMain, .sapUiGlobalBackgroundColor {",
		"    background-color: var(--ph-navy);",
		"    background-image:",
		"        radial-gradient(900px 500px at 90% -10%, rgba(20, 184, 166, 0.16), transparent 60%),",
		"        radial-gradient(700px 400px at -10% 110%, rgba(255, 122, 89, 0.12), transparent 60%);",
		"}",
		"",
		"/* 5. Tile group titles: bold, with a short coral underline */",
		".nepCatTitle {",
		"    font-family: var(--ph-font) !important;",
		"    font-weight: 800 !important;",
		"    letter-spacing: -0.01em;",
		"    color: var(--ph-text) !important;",
		"    padding-bottom: 0.4rem;",
		"    border-bottom: 3px solid var(--ph-coral);",
		"    width: fit-content;",
		"}",
		"",
		"/* 6. Tiles (cards): rounded, a teal bar on the left, lift on hover */",
		".nepFCard.sapFCard {",
		"    background: var(--ph-surface) !important;",
		"    border: 1px solid var(--ph-line) !important;",
		"    border-left: 5px solid var(--ph-teal) !important;",
		"    border-radius: 18px !important;",
		"    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);",
		"    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;",
		"}",
		".nepFCard.sapFCard:hover {",
		"    transform: translateY(-4px);",
		"    background: var(--ph-surface-hover) !important;",
		"    box-shadow: 0 14px 30px rgba(20, 184, 166, 0.22);",
		"    border-left-color: var(--ph-coral) !important;",
		"}",
		".nepFCard .sapFCardTitle {",
		"    color: var(--ph-text) !important;",
		"    font-weight: 700 !important;",
		"}",
		".nepFCard .sapFCardSubtitle {",
		"    color: var(--ph-text-muted) !important;",
		"}",
		".nepFCard .nepCardIcon .sapUiIcon {",
		"    color: var(--ph-teal-light) !important;",
		"}",
		""
	],
	"package": "bfd1586e-0116-4cb9-86d6-a420a40859c2"
}